# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_WORD=
# Необязательно. Числовой ID канала, например -1001234567890
TELEGRAM_MONITORING_CHANNEL_ID=

# Отдельное веб-приложение Google Apps Script для Monitoring Bot V3
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec
GOOGLE_APPS_SCRIPT_API_KEY=
GOOGLE_HTTP_TIMEOUT_SECONDS=30
GOOGLE_HTTP_ATTEMPTS=3

# Путь может быть абсолютным или относительным к корню проекта
COLLATERAL_EXCEL_PATH=ID_Недвижимость v.2.xlsx

LOOKBACK_HOURS=12
TIMEZONE=Asia/Yekaterinburg
LOG_FILE=logs/monitoring_bot_v3.log
# Локальное состояние включения рассылки и последних результатов
AUTOMATION_STATE_FILE=data/automation_state.json

# SMTP over SSL (по умолчанию совместимо с механизмом V2/Yandex)
EMAIL_SMTP_HOST=smtp.yandex.ru
EMAIL_SMTP_PORT=465
EMAIL_LOGIN=
EMAIL_PASSWORD=
EMAIL_TIMEOUT_SECONDS=30

